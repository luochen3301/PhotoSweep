PUID=1000
PGID=1000
PHOTOSWEEP_PORT=8080
PHOTOS_PATH=./sample-media
PHOTOSWEEP_DATA_PATH=./data
PHOTOSWEEP_CACHE_PATH=./cache
PHOTOSWEEP_TRASH_PATH=./trash

PHOTOSWEEP_DATA_DIR=/app/data
PHOTOSWEEP_CACHE_DIR=/app/cache
PHOTOSWEEP_TRASH_DIR=/trash
PHOTOSWEEP_ALLOWED_MEDIA_ROOTS=/media
PHOTOSWEEP_COOKIE_SECURE=false
# HTTPS reverse proxy: set the exact browser origin, e.g. https://photos.example.com
PHOTOSWEEP_PUBLIC_ORIGIN=
# Only the actual reverse-proxy IPs; never use * on an exposed port.
FORWARDED_ALLOW_IPS=127.0.0.1
PHOTOSWEEP_SESSION_DAYS=14
PHOTOSWEEP_JOB_WORKERS=1
PHOTOSWEEP_METADATA_WORKERS=2
TZ=Pacific/Auckland
