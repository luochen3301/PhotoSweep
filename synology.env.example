# 用 SSH 执行 `id <DSM用户名>` 获取真实 UID/GID，不能直接照抄示例值。
PUID=1000
PGID=1000
TZ=Pacific/Auckland
PHOTOSWEEP_PORT=8080
PHOTOSWEEP_VERSION=latest
PHOTOSWEEP_COOKIE_SECURE=false

# Synology Photos 个人空间通常为 /volume1/homes/<DSM用户名>/Photos
# 共享空间通常为 /volume1/photo
PHOTOS_PATH=/volume1/homes/CHANGE_ME/Photos
PHOTOS_MODE=ro

PHOTOSWEEP_DATA_PATH=/volume1/docker/photosweep/data
PHOTOSWEEP_CACHE_PATH=/volume1/docker/photosweep/cache
PHOTOSWEEP_TRASH_PATH=/volume1/docker/photosweep/trash
